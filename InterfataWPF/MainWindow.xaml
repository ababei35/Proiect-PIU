<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Furaje - Panou Central (MVVM)" Height="750" Width="950"
        MinWidth="800" MinHeight="650" Background="#F4F6F9">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#DDE2E5" BorderThickness="1" CornerRadius="8" Margin="0,0,15,0" Padding="20">
            <StackPanel>
                <TextBlock Text="INFORMAȚII FACTURĂ" FontWeight="Heavy" FontSize="15" Foreground="#2980B9" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Separator Margin="0,0,0,15" Background="#E0E4E8"/>

                <Label Content="_Nume Client:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" Background="#FAFAFA" Margin="0,0,0,8" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="_Prenume Client:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Prenume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" Background="#FAFAFA" Margin="0,0,0,8" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="_Telefon:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Telefon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" Background="#FAFAFA" Margin="0,0,0,8" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="_Adresa:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Adresa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" Background="#FAFAFA" Margin="0,0,0,8" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="_Cantitate (kg):" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Cantitate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" Background="#FAFAFA" Margin="0,0,0,12" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="Tip Furaj:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <ComboBox ItemsSource="{Binding Produse}" SelectedItem="{Binding ProdusSelectat, Mode=TwoWay}" Height="28" Background="#FAFAFA" Margin="0,0,0,12" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="Data Facturii:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <DatePicker SelectedDate="{Binding DataFacturii, Mode=TwoWay}" Height="28" Background="#FAFAFA" Margin="0,0,0,12" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                <Label Content="Metoda Plată:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <ListBox ItemsSource="{Binding MetodePlata}" SelectedItem="{Binding MetodaPlataSelectata, Mode=TwoWay}" Height="65" Background="#FAFAFA" Margin="0,0,0,12" SelectionMode="Single" BorderBrush="#BDC3C7"/>

                <Label Content="Tip Client:" FontWeight="Bold" Foreground="#34495E" Padding="0" Margin="0,0,0,3"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton Content="Persoană Fizică" IsChecked="{Binding IsPersoanaFizica, Mode=TwoWay}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Persoană Juridică" IsChecked="{Binding IsPersoanaJuridica, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox Content="Livrare la domiciliu" IsChecked="{Binding IsLivrare, Mode=TwoWay}" FontWeight="Bold" Foreground="#2980B9" Margin="0,0,0,15" VerticalAlignment="Center"/>

                <TextBlock Text="{Binding MesajText}" Foreground="{Binding MesajCuloare}" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap" MinHeight="20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button Content="Reset" Command="{Binding ResetCommand}" Width="80" Height="30" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Adaugă" Command="{Binding AdaugaCommand}" Width="80" Height="30" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DDE2E5" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox ItemsSource="{Binding CriteriiCautare}" SelectedItem="{Binding CriteriuSelectat, Mode=TwoWay}" Grid.Column="0" Width="110" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center" BorderBrush="#BDC3C7"/>

                    <TextBox Text="{Binding TextCautare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" BorderBrush="#BDC3C7" Padding="5,0"/>

                    <Button Content="Caută" Command="{Binding CautaCommand}" Grid.Column="2" Width="90" Height="30" Margin="0,0,15,0" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Label Grid.Column="3" Content="{Binding ElementName=dgFacturi, Path=Items.Count, StringFormat='Total facturi: {0}'}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <DataGrid x:Name="dgFacturi" Grid.Row="1" ItemsSource="{Binding ListaFacturi}" SelectedItem="{Binding FacturaSelectata, Mode=TwoWay}" 
                      AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" 
                      AlternatingRowBackground="#EBF5FB" RowBackground="White" 
                      BorderBrush="#BDC3C7" BorderThickness="1" HorizontalGridLinesBrush="#ECF0F1" VerticalGridLinesBrush="#ECF0F1"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Modifică" Command="{Binding ModificaCommand}" Width="100" Height="32" Margin="0,0,10,0" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Șterge" Command="{Binding StergeCommand}" Width="100" Height="32" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Raport Consum Materie Primă" Command="{Binding RaportMaterieCommand}" Width="200" Height="32" Margin="15,0,0,0" FontWeight="Bold" Background="#2C3E50" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>