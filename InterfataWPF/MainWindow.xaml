<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Furaje - Panou Central (MVVM)" Height="750" Width="950"
        MinWidth="800" MinHeight="650">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <Label Content="_Nume Client:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,5" VerticalContentAlignment="Center"/>

            <Label Content="_Prenume Client:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Prenume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,5" VerticalContentAlignment="Center"/>

            <Label Content="_Telefon:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Telefon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,5" VerticalContentAlignment="Center"/>

            <Label Content="_Adresa:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Adresa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,5" VerticalContentAlignment="Center"/>

            <Label Content="_Cantitate (kg):" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Cantitate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <Label Content="Tip Furaj:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Produse}" SelectedItem="{Binding ProdusSelectat, Mode=TwoWay}" Height="25" Margin="0,0,0,10"/>

            <Label Content="Data Facturii:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <DatePicker SelectedDate="{Binding DataFacturii, Mode=TwoWay}" Height="25" Margin="0,0,0,10"/>

            <Label Content="Metoda Plată:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding MetodePlata}" SelectedItem="{Binding MetodaPlataSelectata, Mode=TwoWay}" Height="60" Margin="0,0,0,10" SelectionMode="Single"/>

            <Label Content="Tip Client:" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Persoană Fizică" IsChecked="{Binding IsPersoanaFizica, Mode=TwoWay}" Margin="0,0,15,0"/>
                <RadioButton Content="Persoană Juridică" IsChecked="{Binding IsPersoanaJuridica, Mode=OneWay}"/>
            </StackPanel>

            <CheckBox Content="Livrare la domiciliu" IsChecked="{Binding IsLivrare, Mode=TwoWay}" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding MesajText}" Foreground="{Binding MesajCuloare}" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset" Command="{Binding ResetCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                <Button Content="Adaugă" Command="{Binding AdaugaCommand}" Width="80" Height="30"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox ItemsSource="{Binding CriteriiCautare}" SelectedItem="{Binding CriteriuSelectat, Mode=TwoWay}" Grid.Column="0" Width="100" Height="25" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                <TextBox Text="{Binding TextCautare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                <Button Content="Caută" Command="{Binding CautaCommand}" Grid.Column="2" Width="80" Height="25" Margin="0,0,15,0"/>

                <Label Grid.Column="3" Content="{Binding ElementName=dgFacturi, Path=Items.Count, StringFormat='Total facturi: {0}'}" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>

            <DataGrid x:Name="dgFacturi" Grid.Row="1" ItemsSource="{Binding ListaFacturi}" SelectedItem="{Binding FacturaSelectata, Mode=TwoWay}" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Modifică" Command="{Binding ModificaCommand}" Width="100" Height="30" Margin="0,0,10,0"/>
                <Button Content="Șterge" Command="{Binding StergeCommand}" Width="100" Height="30" Background="#C0392B" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>