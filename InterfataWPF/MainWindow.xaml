<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Furaje - Adăugare" Height="350" Width="400">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="_Nume Client:" Target="{Binding ElementName=txtNume}" FontWeight="Bold" Margin="0,0,10,10"/>
        <TextBox x:Name="txtNume" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

        <Label Grid.Row="1" Grid.Column="0" Content="_Prenume Client:" Target="{Binding ElementName=txtPrenume}" FontWeight="Bold" Margin="0,0,10,10"/>
        <TextBox x:Name="txtPrenume" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

        <Label Grid.Row="2" Grid.Column="0" Content="_Cantitate (kg):" Target="{Binding ElementName=txtCantitate}" FontWeight="Bold" Margin="0,0,10,10"/>
        <TextBox x:Name="txtCantitate" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

        <TextBlock x:Name="tbMesaj" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                   Foreground="Red" FontWeight="Bold" Margin="0,10,0,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Reset" Width="80" Height="30" Margin="0,0,10,0" Click="BtnReset_Click"/>
            <Button Content="Adaugă" Width="80" Height="30" Click="BtnAdauga_Click"/>
        </StackPanel>
    </Grid>
</Window>