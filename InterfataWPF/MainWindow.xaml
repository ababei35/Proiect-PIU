<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Furaje - Afișare Factură" Height="350" Width="500"
        Background="#F4F6F6">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
    </Window.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock Text="Detalii Ultima Factură" 
                   FontFamily="Segoe UI Semibold" 
                   FontSize="24" 
                   Foreground="#2980B9" 
                   Margin="0,0,0,20" 
                   HorizontalAlignment="Center"/>

        <Label x:Name="lblClient" Content="Client: - "/>
        <Label x:Name="lblProdus" Content="Produs: - "/>
        <Label x:Name="lblCantitate" Content="Cantitate: - "/>

    </StackPanel>
</Window>